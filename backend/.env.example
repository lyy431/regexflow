# Copy this file to backend/.env and fill it in. Never commit the real .env file.

# --- Django -------------------------------------------------------------------
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.example.com
# Number of reverse proxies in front of the app (lets rate limiting see real client IPs).
# NUM_PROXIES=1

# --- LLM providers: tried in this order; ones without a key are skipped ----------
LLM_PROVIDERS=gemini,groq
# Seconds one provider may take before the next one is tried (there are no retries).
# LLM_TIMEOUT_SECONDS=15

# Google Gemini API free tier. Create a key at https://aistudio.google.com/apikey
# (do not link a billing account and you will never be charged).
GEMINI_API_KEY=
# Flash-Lite is the fastest; set a larger model such as gemini-3.8-flash if you prefer.
GEMINI_MODEL=gemini-3.1-flash-lite

# Groq free plan. Create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional: your own model behind any OpenAI-compatible server
# (Ollama, llama.cpp, vLLM, LM Studio). Add "local" to LLM_PROVIDERS to use it.
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=my-model
# LOCAL_LLM_JSON_MODE=json_object   # json_schema | json_object | none

# --- Limits ---------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
# Datasets idle for longer than this are deleted (0 = keep forever).
DATASET_TTL_HOURS=24
REGEX_TIMEOUT_SECONDS=10
# Per-IP rate limits (DRF syntax: <number>/<second|minute|hour|day>).
LLM_RATE_LIMIT=60/hour
UPLOAD_RATE_LIMIT=30/hour

# --- Storage ----------------------------------------------------------------------
# Folder for the SQLite database and uploaded data (defaults to backend/var).
# DATA_DIR=/var/data
